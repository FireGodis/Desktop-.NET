<Window x:Class="DesktopMvvm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minhas tarefas" Height="320" Width="420">
    <StackPanel Margin="16">
        <TextBlock Text="Minhas tarefas" FontSize="22" Margin="0,0,0,12"/>
        <DockPanel Margin="0,0,0,12">
            <Button Content="Adicionar" Command="{Binding AddTaskCommand}" DockPanel.Dock="Right"/>
            <TextBox Text="{Binding NewTask, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Tasks}"/>
    </StackPanel>
</Window>
